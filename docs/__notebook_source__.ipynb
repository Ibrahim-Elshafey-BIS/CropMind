import kagglehub
import os
import pandas as pd

print("="*60)
print("الخطوة 1: تحميل البيانات")
print("="*60)

# تحميل المجلد
dataset_path = "khandelwalmanas/daily-commodity-prices-india"
download_path = kagglehub.dataset_download(dataset_path)

print(f"✅ تم التحميل في: {download_path}")

# تحديد مجلد parquet
parquet_folder = os.path.join(download_path, 'parquet')
print(f"📂 مجلد Parquet: {parquet_folder}")

# قراءة الملفات
files = ['2022.parquet', '2023.parquet', '2024.parquet']
dfs = []

for file in files:
    file_path = os.path.join(parquet_folder, file)
    df = pd.read_parquet(file_path)
    dfs.append(df)
    print(f"  ✅ {file}: {len(df):,} صفوف")

# دمج البيانات
df_all = pd.concat(dfs, ignore_index=True)
print(f"\n✅ إجمالي البيانات: {len(df_all):,} صف")
print(f"📊 الأعمدة: {df_all.columns.tolist()}")


print("="*60)
print("الخطوة 2: فلترة السلع المطلوبة")
print("="*60)

# السلع المطلوبة
commodities = ['Tomato', 'Onion', 'Potato', 'Wheat', 'Brinjal']

# فلترة البيانات
df_filtered = df_all[df_all['Commodity'].isin(commodities)].copy()

print(f"✅ إجمالي الصفوف بعد الفلترة: {len(df_filtered):,}")

# عدد الصفوف لكل سلعة
print("\n📊 عدد الصفوف لكل سلعة:")
for commodity in commodities:
    count = len(df_filtered[df_filtered['Commodity'] == commodity])
    print(f"  {commodity}: {count:,} صف")


print("="*60)
print("الخطوة 4: تنظيف البيانات من القيم الشاذة")
print("="*60)

# تعريف حدود معقولة لكل سلعة
price_limits = {
    'Tomato': (500, 10000),
    'Onion': (500, 8000),
    'Potato': (500, 5000),
    'Wheat': (1000, 4000),
    'Brinjal': (500, 6000)
}

# تنظيف البيانات لكل سلعة
cleaned_data = {}

for commodity in commodities:
    df_commodity = df_filtered[df_filtered['Commodity'] == commodity].copy()
    
    # تحديد الحدود
    min_price, max_price = price_limits[commodity]
    
    # فلترة القيم ضمن النطاق
    df_clean = df_commodity[
        (df_commodity['Modal_Price'] >= min_price) & 
        (df_commodity['Modal_Price'] <= max_price)
    ]
    
    print(f"\n📊 {commodity}:")
    print(f"  قبل التنظيف: {len(df_commodity):,} صف")
    print(f"  بعد التنظيف: {len(df_clean):,} صف")
    print(f"  تم حذف: {len(df_commodity) - len(df_clean):,} صف")
    
    # إعادة حساب المتوسط اليومي
    df_clean['Date'] = pd.to_datetime(df_clean['Arrival_Date'])
    df_daily = df_clean.groupby('Date')['Modal_Price'].mean().reset_index()
    df_daily.columns = ['ds', 'y']
    df_daily = df_daily.sort_values('ds').reset_index(drop=True)
    
    cleaned_data[commodity] = df_daily
    
    print(f"  عدد الأيام: {len(df_daily)}")
    print(f"  متوسط السعر: {df_daily['y'].mean():.2f}")
    print(f"  أقل سعر: {df_daily['y'].min():.2f}")
    print(f"  أعلى سعر: {df_daily['y'].max():.2f}")


print("="*60)
print("الخطوة 5: تدريب نموذج Prophet لكل سلعة")
print("="*60)

from prophet import Prophet
from sklearn.metrics import mean_absolute_error
import numpy as np
import warnings
warnings.filterwarnings('ignore')

# تخزين النتائج
models = {}
results = {}

for commodity in commodities:
    print(f"\n📊 تدريب نموذج: {commodity}")
    
    # جلب البيانات
    df_daily = cleaned_data[commodity].copy()
    
    # تقسيم البيانات (آخر 90 يوم للاختبار)
    test_size = 90
    train = df_daily[:-test_size]
    test = df_daily[-test_size:]
    
    # بناء النموذج
    model = Prophet(
        yearly_seasonality=True,
        weekly_seasonality=True,
        seasonality_mode='multiplicative',
        changepoint_prior_scale=0.05
    )
    
    model.fit(train)
    
    # التنبؤ على فترة الاختبار
    future_test = model.make_future_dataframe(periods=len(test), include_history=False)
    forecast_test = model.predict(future_test)
    
    # استخراج النتائج
    y_true = test['y'].values
    y_pred = forecast_test['yhat'].values[:len(test)]
    
    # حساب الأخطاء
    mae = mean_absolute_error(y_true, y_pred)
    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100
    
    # تخزين النموذج والنتائج
    models[commodity] = model
    results[commodity] = {
        'mae': mae,
        'mape': mape,
        'test': test,
        'y_true': y_true,
        'y_pred': y_pred
    }
    
    print(f"  ✅ MAE: {mae:.2f}")
    print(f"  ✅ MAPE: {mape:.2f}%")
    
    if mape < 10:
        print(f"  🎉 {commodity}: MAPE أقل من 10% (ممتاز)")
    else:
        print(f"  ⚠️ {commodity}: MAPE أعلى من 10% (يحتاج تحسين)")

# عرض ملخص النتائج
print("\n" + "="*60)
print("📊 ملخص النتائج:")
print("="*60)
for commodity in commodities:
    mae = results[commodity]['mae']
    mape = results[commodity]['mape']
    status = "✅ ممتاز" if mape < 10 else "⚠️ يحتاج تحسين"
    print(f"  {commodity}: MAE = {mae:.2f}, MAPE = {mape:.2f}% → {status}")


print("="*60)
print("الخطوة 6: تحسين نموذج Tomato و Onion")
print("="*60)

# السلع اللي محتاجة تحسين
commodities_to_tune = ['Tomato', 'Onion']

for commodity in commodities_to_tune:
    print(f"\n🔧 تحسين نموذج: {commodity}")
    
    df_daily = cleaned_data[commodity].copy()
    test_size = 90
    train = df_daily[:-test_size]
    test = df_daily[-test_size:]
    
    # تجربة إعدادات مختلفة
    model = Prophet(
        yearly_seasonality=True,
        weekly_seasonality=True,
        daily_seasonality=False,
        seasonality_mode='additive',  # تغيير من multiplicative
        changepoint_prior_scale=0.5,   # زيادة
        seasonality_prior_scale=10.0    # زيادة
    )
    
    # إضافة موسمية يدوية
    model.add_seasonality(name='monthly', period=30.5, fourier_order=5)
    
    model.fit(train)
    
    future_test = model.make_future_dataframe(periods=len(test), include_history=False)
    forecast_test = model.predict(future_test)
    
    y_true = test['y'].values
    y_pred = forecast_test['yhat'].values[:len(test)]
    
    mae = mean_absolute_error(y_true, y_pred)
    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100
    
    # تحديث النموذج في القاموس
    models[commodity] = model
    results[commodity] = {
        'mae': mae,
        'mape': mape,
        'test': test,
        'y_true': y_true,
        'y_pred': y_pred
    }
    
    print(f"  ✅ MAE: {mae:.2f}")
    print(f"  ✅ MAPE: {mape:.2f}%")
    
    if mape < 10:
        print(f"  🎉 {commodity}: تحسن! MAPE أقل من 10%")
    else:
        print(f"  ⚠️ {commodity}: لسه MAPE أعلى من 10%")

# عرض الملخص النهائي
print("\n" + "="*60)
print("📊 الملخص النهائي:")
print("="*60)
for commodity in commodities:
    mae = results[commodity]['mae']
    mape = results[commodity]['mape']
    status = "✅ ممتاز" if mape < 10 else "⚠️ يحتاج تحسين"
    print(f"  {commodity}: MAE = {mae:.2f}, MAPE = {mape:.2f}% → {status}")


print("="*60)
print("الخطوة 7: تحسين Tomato و Onion (بطريقة مختلفة)")
print("="*60)

# السلع اللي محتاجة تحسين
commodities_to_tune = ['Tomato', 'Onion']

for commodity in commodities_to_tune:
    print(f"\n🔧 تحسين نموذج: {commodity}")
    
    df_daily = cleaned_data[commodity].copy()
    test_size = 90
    train = df_daily[:-test_size]
    test = df_daily[-test_size:]
    
    # إعدادات مختلفة
    model = Prophet(
        yearly_seasonality=True,
        weekly_seasonality=True,
        daily_seasonality=False,
        seasonality_mode='additive',
        changepoint_prior_scale=0.05,
        seasonality_prior_scale=5.0,
        interval_width=0.95
    )
    
    # إضافة موسمية شهرية
    model.add_seasonality(name='monthly', period=30.5, fourier_order=3)
    
    # إضافة حد أدنى للسعر
    model = model.set_floor(0)
    
    model.fit(train)
    
    future_test = model.make_future_dataframe(periods=len(test), include_history=False)
    forecast_test = model.predict(future_test)
    
    # التأكد من عدم وجود أسعار سالبة
    forecast_test['yhat'] = forecast_test['yhat'].clip(lower=0)
    
    y_true = test['y'].values
    y_pred = forecast_test['yhat'].values[:len(test)]
    
    mae = mean_absolute_error(y_true, y_pred)
    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100
    
    # تحديث النموذج في القاموس
    models[commodity] = model
    results[commodity] = {
        'mae': mae,
        'mape': mape,
        'test': test,
        'y_true': y_true,
        'y_pred': y_pred
    }
    
    print(f"  ✅ MAE: {mae:.2f}")
    print(f"  ✅ MAPE: {mape:.2f}%")
    
    if mape < 10:
        print(f"  🎉 {commodity}: تحسن! MAPE أقل من 10%")
    else:
        print(f"  ⚠️ {commodity}: لسه MAPE أعلى من 10%")


