import numpy as np
from sklearn.preprocessing import MinMaxScaler
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout
from tensorflow.keras.callbacks import EarlyStopping

def create_sequences(data, lookback=30):
    X, y = [], []
    for i in range(lookback, len(data)):
        X.append(data[i-lookback:i, 0])
        y.append(data[i, 0])
    return np.array(X), np.array(y)

# السلع اللي محتاجة LSTM
lstm_commodities = ['Tomato', 'Onion']

for commodity in lstm_commodities:
    print(f"\n🧠 تدريب LSTM لـ {commodity}")
    
    df_daily = cleaned_data[commodity].copy()
    test_size = 90
    
    # تحضير البيانات
    data = df_daily['y'].values.reshape(-1, 1)
    scaler = MinMaxScaler()
    data_scaled = scaler.fit_transform(data)
    
    # تقسيم Train/Test
    train_data = data_scaled[:-test_size]
    test_data = data_scaled[-test_size:]
    
    # إنشاء sequences
    lookback = 30
    X_train, y_train = create_sequences(train_data, lookback)
    X_test, y_test = create_sequences(test_data, lookback)
    
    # إعادة تشكيل للـ LSTM
    X_train = X_train.reshape(X_train.shape[0], X_train.shape[1], 1)
    X_test = X_test.reshape(X_test.shape[0], X_test.shape[1], 1)
    
    # بناء النموذج
    model = Sequential([
        LSTM(50, return_sequences=True, input_shape=(lookback, 1)),
        Dropout(0.2),
        LSTM(50, return_sequences=False),
        Dropout(0.2),
        Dense(25, activation='relu'),
        Dense(1)
    ])
    
    model.compile(optimizer='adam', loss='mse', metrics=['mae'])
    
    # تدريب
    early_stop = EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True)
    
    history = model.fit(
        X_train, y_train,
        validation_split=0.2,
        epochs=50,
        batch_size=32,
        callbacks=[early_stop],
        verbose=0
    )
    
    # التنبؤ
    y_pred_scaled = model.predict(X_test, verbose=0)
    y_pred = scaler.inverse_transform(y_pred_scaled)
    
    y_true = df_daily['y'].values[-len(y_pred):]
    y_pred = y_pred.flatten()
    
    mae = mean_absolute_error(y_true, y_pred)
    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100
    
    # حفظ النموذج
    model.save(f'/kaggle/working/models/{commodity}_lstm.h5')
    with open(f'/kaggle/working/models/{commodity}_lstm_scaler.pkl', 'wb') as f:
        pickle.dump(scaler, f)
    
    print(f"  ✅ MAE: {mae:.2f}")
    print(f"  ✅ MAPE: {mape:.2f}%")
    
    if mape < 10:
        print(f"  🎉 {commodity}: LSTM حقق MAPE < 10%")
    else:
        print(f"  ⚠️ {commodity}: LSTM لسه {mape:.2f}%")

print("\n✅ تم تدريب جميع نماذج LSTM!")



